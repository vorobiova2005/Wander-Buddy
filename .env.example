# Names only - real values live in Code/.env (outside git), ../_secrets/ and GitHub Actions secrets.
# Adding a variable? Add it here, to docker-compose.yml and to .github/workflows/cd.yml.

# <--- AI and places (used from step 03 on) --->
GROQ_API_KEY=
OPENTRIPMAP_API_KEY=

# <--- Server --->
# Port of the API server (default 8080)
# PORT=8080
# Origins allowed by CORS, comma-separated (default: the production site and the Vite dev server)
# CORS_ORIGINS=https://wander-buddy.zebaro.dev,http://localhost:5173
# Host port of the web container on the server (GitHub Actions variable SERVER_PORT, default 8080)
# SERVER_PORT=8080
